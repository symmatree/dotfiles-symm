#!/usr/bin/env bash
# role-tmux <home-repo>/<role> [claude args...]
#
# Start a role in its own detached tmux session, role-<role>, with Remote Control
# on and named after the role, so it can be reached from claude.ai or the phone.
# The new session belongs to the tmux server, not to whoever ran this. Exits
# non-zero, printing what the launch printed, if role stops before claude is up.
set -euo pipefail

[ $# -ge 1 ] || {
	echo "usage: role-tmux <home-repo>/<role> [claude args...]" >&2
	exit 2
}
spec=$1
shift
role=${spec#*/}
session=role-$role
here=$(dirname "$(readlink -f "$0")")

cmd=$(printf '%q ' "$here/role" "$spec" --remote-control "$role" "$@")
# remain-on-exit is set before the command starts, so a launch that fails at once
# still leaves its output to read.
tmux new-session -d -s "$session" -c "$HOME" -x 200 -y 50 \; \
	set-option -t "$session" remain-on-exit on \; \
	respawn-pane -k -t "$session" "$cmd"

# role clones and syncs before claude starts; give it time to fail.
for _ in $(seq 1 30); do
	if [ "$(tmux display -p -t "$session" '#{pane_dead}')" = 1 ]; then
		tmux capture-pane -p -t "$session" >&2
		tmux kill-session -t "$session"
		exit 1
	fi
	url=$(tmux capture-pane -p -J -t "$session" | grep 'remote-control is active' | grep -o 'https://[^ ]*' || true)
	if [ -n "$url" ]; then
		echo "$session: running, $url"
		exit 0
	fi
	sleep 2
done
echo "$session: started, but Remote Control has not shown up after 60s:" >&2
tmux capture-pane -p -t "$session" >&2
exit 1
