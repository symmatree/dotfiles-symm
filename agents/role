#!/usr/bin/env bash
# role <home-repo>/<role> [claude args...]
#
# Start the Claude session for one role in its workspace, ~/roles/<role>, in a tmux
# session named role-<role>. Layout and the role package are in agents/README.md.
set -euo pipefail

usage() {
	echo "usage: role <home-repo>/<role> [claude args...]" >&2
	exit 2
}

[ $# -ge 1 ] || usage
spec=$1
shift
home_repo=${spec%%/*}
role=${spec#*/}
if [ -z "$home_repo" ] || [ -z "$role" ] || [ "$home_repo" = "$spec" ]; then
	usage
fi

session=role-$role
if tmux has-session -t "=$session" 2>/dev/null; then
	echo "role: tmux session $session already exists: tmux attach -t $session" >&2
	exit 1
fi

owner=symmatree
ws=$HOME/roles/$role
mkdir -p "$ws"

clone_if_missing() {
	[ -d "$ws/$1/.git" ] || git clone "https://github.com/$owner/$1.git" "$ws/$1"
}

# Switch to main and fast-forward it; a checkout with uncommitted changes, or a
# main that cannot fast-forward, is left as it is.
sync_main() {
	local r=$ws/$1
	if [ -n "$(git -C "$r" status --porcelain)" ]; then
		echo "role: leaving $r as it is, it has uncommitted changes" >&2
		return
	fi
	git -C "$r" checkout -q main && git -C "$r" pull -q --ff-only ||
		echo "role: $r did not fast-forward to origin/main" >&2
}

clone_if_missing "$home_repo"
sync_main "$home_repo"

pkg_dir=$ws/$home_repo/agents
[ -d "$pkg_dir/$role" ] || {
	echo "role: no $home_repo/agents/$role" >&2
	exit 1
}

# dotfiles-symm carries the shared workspace guidance, so every role has it.
mapfile -t repos < <(grep -v -E '^\s*(#|$)' "$pkg_dir/$role/repos")
for r in dotfiles-symm "${repos[@]}"; do
	[ "$r" = "$home_repo" ] && continue
	clone_if_missing "$r"
	sync_main "$r"
done

stow --no-folding --ignore='^repos$' -d "$pkg_dir" -t "$ws" -R "$role"

cmd=$(printf '%q ' claude --name "$role" --remote-control "$role" "$@")
tmux new-session -d -s "$session" -c "$ws" "$cmd"

# From a terminal, go to the new session; otherwise (an agent) leave it detached.
if [ -t 0 ] && [ -t 1 ]; then
	if [ -n "${TMUX:-}" ]; then
		exec tmux switch-client -t "=$session"
	fi
	exec tmux attach -t "=$session"
fi
echo "role: started $session"
