# Camera pod -- Raspberry Pi Zero 2 W (512 MB), SD card. Role knobs consumed by
# build-image.sh + assemble-btrfs.sh. Same btrfs graph as every other role; only
# these knobs differ. See coordinator#96 "one btrfs layout, per-role knobs".

# @data is the pod's capture volume. Matches coord_state_root in the coordinator
# repo's pod ansible role (host/ansible/roles/pod/tasks/main.yml), which creates
# /var/lib/pod/{config,captures} on top of it.
DATA_MOUNT=/var/lib/pod

# SD medium: single metadata to halve write-amplification.
METADATA=single

# No config.txt append. The camera is covered by the vendor default
# camera_auto_detect=1, and the dwc2/g_ether gadget net + pps-gpio overlays are
# Phase 3 of pod bring-up (coordinator docs/pi-zero-bringup.md), not Phase 1
# host bootstrap -- they also need a cmdline knob (modules-load=) that this
# build does not have yet. Added when Phase 3 lands, not speculatively.
