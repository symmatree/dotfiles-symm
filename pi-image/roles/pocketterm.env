# PocketTerm35 "pipboy" -- Pi 5 / NVMe handheld terminal (tiles #599).
# Role knobs consumed by build-image.sh + assemble-btrfs.sh. Same btrfs graph as
# every other role; only these knobs differ. See coordinator#96 "one btrfs
# layout, per-role knobs".

# @data is pipboy's bulk store (large files, one-way synced to the NAS). Same
# subvol + mount options as the coordinator's capture volume, different path.
DATA_MOUNT=/var/lib/store

# Final medium is the NVMe SSD: dup metadata for redundancy on a single,
# DRAM-less drive. The SD bootstrap carries the same bytes; the extra
# write-amplification there is acceptable for a validation/rollback card.
METADATA=dup

# Display / touch / keyboard / PCIe lines appended to config.txt
# (path relative to pi-image/).
CONFIG_APPEND=roles/pocketterm/config.append.txt

# Waveshare 3.5" panel device-tree overlay, fetched + sha-pinned at build time.
# Contents: waveshare-35dpi-5b.dtbo (Pi 5) + 3b/4b variants.
OVERLAY_ZIP_URL=https://files.waveshare.com/wiki/common/3.5HDMI_E_DTBO.zip
OVERLAY_ZIP_SHA256=bc184c27a2750fb0bd4c8aa18775134d006d4dd8c1b41cff1695648bff3250ad
