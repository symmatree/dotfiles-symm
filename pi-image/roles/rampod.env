# Camera pod on a Radxa Zero 3W ("rampod") -- RK3566, 2 GB, SD card. A campod's
# job on a board that can still be bought. Plan and sources: RADXA-ZERO3.md.
#
# BOARD sends build-image.sh to build-rockchip.sh, which converts Armbian
# (vendor kernel) instead of Raspberry Pi OS. Same btrfs graph as every other
# role; the knobs below mean what they mean in the Pi roles unless noted.
BOARD=radxa-zero3

# @data, the capture volume. The same path as campod's, because the payload
# plumbing is shared code keyed on it. LOCKSTEP WITH THE COORDINATOR REPO, as in
# campod.env -- there is no rampod converge yet to lock against.
DATA_MOUNT=/var/lib/campod

# SD medium: single metadata to halve write-amplification.
METADATA=single

# Device-tree overlays, compiled from roles/rampod/*.dtso and listed in
# armbianEnv.txt user_overlays=, in this order. rampod is every unit's base.
# No camera overlay for now: the current rampods carry the FLIR, which is USB
# and needs none. roles/rampod/rampod-imx708.dtso and the imx708.ko build stay
# for the IMX708 units to come; listing rampod-imx708 here loads it.
USER_OVERLAYS="rampod"

# Overlays the vendor image already ships, listed in armbianEnv.txt overlays=.
# SPI3 on the M1 pins (header 19/21/23/24) with one spidev on CS0, for the
# ADXL345.
VENDOR_OVERLAYS="rk3568-spi3-m1-cs0-spidev"

# Appended to the kernel command line through armbianEnv.txt extraargs, after the
# btrfs root flags. cma=256M is the vendor image's own value, kept. No psi=1:
# this kernel is built with PSI on by default. usbfs_memory_mb=1000 is FLIR's
# recommendation for its USB3 cameras (the default is 16); it is a cap on usbfs
# buffers, not a reservation, so a unit without the FLIR pays nothing for it.
EXTRAARGS="cma=256M usbcore.usbfs_memory_mb=1000"

# Packages installed into the rootfs at build time, --no-install-recommends.
# The campod list, plus what Armbian minimal lacks and the Pi base has:
# cloud-init for flash-time identity, NetworkManager (with wpasupplicant, which
# it only Recommends) for the gadget and WiFi profiles and pod-link's radio
# control. chrony replaces systemd-timesyncd, as on the campods.
APT_INSTALL="ca-certificates curl git zstd podman uidmap collectd-core chrony pps-tools cloud-init network-manager wpasupplicant"
