# Coordinator -- Pi 4B, SD card. The baseline role; these values are also the
# built-in defaults in build-image.sh / assemble-btrfs.sh, but stated explicitly
# for symmetry with the other roles. See coordinator#96 "one btrfs layout,
# per-role knobs".

# Precious captures/config; disarm takes an RO snapshot of this (coordinator#88).
DATA_MOUNT=/var/lib/coordinator

# SD medium: single metadata to halve write-amplification.
METADATA=single

# Headless flight computer: no display overlays, no config.txt append.
