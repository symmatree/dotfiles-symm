# Coordinator -- Pi 4B, SD card. The baseline role; these values are also the
# built-in defaults in build-image.sh / assemble-btrfs.sh, but stated explicitly
# for symmetry with the other roles. See coordinator#96 "one btrfs layout,
# per-role knobs".

# Precious captures/config; disarm takes an RO snapshot of this (coordinator#88).
DATA_MOUNT=/var/lib/coordinator

# SD medium: single metadata to halve write-amplification.
METADATA=single

# FC UART (enable_uart=1 + disable-bt for PL011 at 1.5 Mbaud) and the front-panel
# I2C bus. Built into the image rather than written by the coordinator ansible
# role, so routine convergence never touches the FAT boot partition -- see
# roles/campod/config.append.txt for why that matters, and coordinator#96.
CONFIG_APPEND=roles/coordinator/config.append.txt

# The FC owns the primary UART, so the serial console must not also be on it.
# The image never writes it in the first place, rather than having ansible strip
# it from cmdline.txt on a running device.
#
# CONSEQUENCE, deliberately stated: a coordinator card has NO serial console from
# first boot. On a Pi 4B, use HDMI to watch a boot that does not come up.
CMDLINE_REMOVE=console=serial0,*
