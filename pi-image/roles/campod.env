# Camera pod ("campod") -- Raspberry Pi Zero 2 W (512 MB), SD card. Role knobs
# consumed by build-image.sh + assemble-btrfs.sh. Same btrfs graph as every other
# role; only these knobs differ. See coordinator#96 "one btrfs layout, per-role
# knobs".
#
# Named campod, not pod: a bare "pod" is hopelessly aliased in a Kubernetes-
# adjacent environment, and these are camera pods specifically (arm-mounted or
# belly-mounted -- the mount point varies, the camera does not).

# @data is the capture volume, and this path is LOCKSTEP WITH THE COORDINATOR
# REPO. It has to equal coord_state_root in host/ansible/roles/campod, which
# creates {config,captures} on top of it.
#
# If the two diverge, @data is simply never mounted where anything writes, so
# captures land on @var: no error, no warning, and the power-loss properties the
# subvolume exists for silently stop applying. The only symptom is
# `findmnt /var/lib/campod` showing @var instead of @data.
#
# Moved from /var/lib/pod alongside coordinator#228, which renamed pod -> campod
# throughout that repo. Changing it again means changing both repos in one
# window.
DATA_MOUNT=/var/lib/campod

# SD medium: single metadata to halve write-amplification.
METADATA=single

# Serial console (enable_uart=1 + dtoverlay=disable-bt) and the dwc2 gadget-net
# overlay. See the file for why each line is there.
CONFIG_APPEND=roles/campod/config.append.txt

# Still NOT here: pps-gpio (no PPS is wired on this vehicle -- coordinator#211),
# and the dwc2/g_ether *module loading*, which is the ansible layer's job via
# /etc/modules-load.d/. The camera itself needs nothing -- the vendor default
# camera_auto_detect=1 covers it.
