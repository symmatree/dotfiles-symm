# Camera pod ("campod") -- Raspberry Pi Zero 2 W (512 MB), SD card. Role knobs
# consumed by build-image.sh + assemble-btrfs.sh. Same btrfs graph as every other
# role; only these knobs differ. See coordinator#96 "one btrfs layout, per-role
# knobs".
#
# Named campod, not pod: a bare "pod" is hopelessly aliased in a Kubernetes-
# adjacent environment, and these are camera pods specifically (arm-mounted or
# belly-mounted -- the mount point varies, the camera does not).

# @data is the capture volume. The PATH is deliberately still /var/lib/pod: it has
# to match coord_state_root in the coordinator repo's pod ansible role
# (host/ansible/roles/pod/tasks/main.yml), which creates /var/lib/pod/{config,
# captures} on top of it. Renaming the path is a coordinated cross-repo change
# (ansible role, /opt/stacks/pod, stacks/pod/, coord stack detection, docs), not
# something the image can do alone -- if @data moved and ansible did not, captures
# would silently land on @var instead.
DATA_MOUNT=/var/lib/pod

# SD medium: single metadata to halve write-amplification.
METADATA=single

# No config.txt append. The camera is covered by the vendor default
# camera_auto_detect=1, and the dwc2/g_ether gadget net + pps-gpio overlays are
# Phase 3 of campod bring-up (coordinator docs/pi-zero-bringup.md), not Phase 1
# host bootstrap -- they also need a cmdline knob (modules-load=) that this
# build does not have yet. Added when Phase 3 lands, not speculatively.
