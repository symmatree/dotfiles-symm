# Fleet-constant provisioning values. Copy to fleet.env (gitignored) and fill in.
#
# THESE ARE SECRETS. fleet.env must never be committed, pasted into an issue/PR,
# or copied onto a machine that does not need it. WIFI_PSK in particular is
# enough to join the network on its own -- it is the passphrase's derived form,
# not a one-way hash of it.
#
# Per-unit values (hostname) are NOT here; they are a Flash-Card.ps1 argument.
#
# This KEY=VALUE shape is what `op inject -i fleet.env.tpl -o fleet.env` consumes,
# so the values can become op:// references in a committed .tpl and be resolved at
# use time instead of living on disk. (`op run --env-file` is the other 1Password
# entry point but injects into the environment, which is not how this script reads
# them.) Not wired up here -- noted so the file shape does not have to change later.

# Login name for the uid-1000 account.
USERNAME=pi

# crypt(3) hash, NOT the plaintext password. Imager emits yescrypt ($y$...) for
# any image dated 2023-01-01 or later; Bookworm's libxcrypt accepts it.
# Generate:  openssl passwd -6 'yourpassword'        (sha512crypt, also fine)
# or copy the hash out of a firstrun.sh that Imager's wizard generated.
PW_HASH=

# The FLEET MANAGEMENT key's public half -- not an operator's key. This is the
# bootstrap credential the card is seeded with so the fleet service can reach it
# from first boot; operator keys arrive by converge. See the comment beside
# ssh_authorized_keys in user-data.template for why it is this one.
#
# Source: `terraform output fleet_ssh_public_key` in tiles tf/nodes, or the
# `public-key` field of the 1Password item `fleet-ssh-key-managed`. The private
# half is in the same item, which is how a person gets into a freshly flashed
# card before it has converged.
#
# NOT itself a secret -- it is a public key. It lives here because this is where
# the flashing values are, not because it needs guarding. PW_HASH and WIFI_PSK in
# this file are the ones that do.
FLEET_PUBKEY=

# Lab WiFi. PSK is the 64-hex-character derived form:
#   wpa_passphrase '<ssid>' '<passphrase>'   ->  the psk= line
WIFI_SSID=
WIFI_PSK=
WIFI_COUNTRY=US

KEYMAP=us
TIMEZONE=America/New_York
